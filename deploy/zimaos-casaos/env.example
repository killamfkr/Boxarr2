# Boxarr stack — generated by install.sh

BOXARR_INSTALL_DIR=/DATA/AppData/boxarr-stack
BOXARR_TORBOX_MOUNT=/DATA/torbox
BOXARR_LIBRARY_ROOT=/DATA/library

PUID=1000
PGID=1000
TZ=UTC

# auto = API key mount if TORBOX_API_KEY is set, else rclone WebDAV
# api  = torbox-media-center container (TORBOX_API_KEY only)
# rclone = host or docker rclone WebDAV (needs TORBOX_WEBDAV_USER/PASS)
MOUNT_PROVIDER=auto
RCLONE_REMOTE=torbox
RCLONE_MODE=host

# Required for install (torbox.app → Settings → API)
TORBOX_API_KEY=

# Only needed when MOUNT_PROVIDER=rclone (WebDAV email + password, NOT the API key)
TORBOX_WEBDAV_USER=
TORBOX_WEBDAV_PASS=

# Optional Boxarr pre-seed (or configure in the UI after first boot)
PROWLARR_URL=http://host.docker.internal:9696
PROWLARR_API_KEY=
TMDB_API_KEY=
BOXARR_SEERR_API_KEY=

BOXARR_IMAGE=ghcr.io/radaiko/boxarr:latest
WITH_SEERR=true
