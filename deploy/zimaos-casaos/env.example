# Boxarr stack — generated by install.sh
# Copy to .env and edit, or pass these as environment variables to install.sh

# Install paths (CasaOS / ZimaOS use /DATA)
BOXARR_INSTALL_DIR=/DATA/AppData/boxarr-stack
BOXARR_TORBOX_MOUNT=/DATA/torbox
BOXARR_LIBRARY_ROOT=/DATA/library

# Run containers as this user (defaults to the user running install.sh)
PUID=1000
PGID=1000

TZ=UTC

# rclone remote name in rclone.conf (must match [torbox] section)
RCLONE_REMOTE=torbox

# TorBox WebDAV credentials (torbox.app account email + password)
# Get WebDAV access from https://support.torbox.app/en/articles/14662867-torbox-webdav
TORBOX_WEBDAV_USER=
TORBOX_WEBDAV_PASS=

# Optional Boxarr pre-seed (or configure in the UI after first boot)
TORBOX_API_KEY=
PROWLARR_URL=http://host.docker.internal:9696
PROWLARR_API_KEY=
TMDB_API_KEY=
BOXARR_SEERR_API_KEY=

# Docker image override
BOXARR_IMAGE=ghcr.io/radaiko/boxarr:latest

# Set false to skip Seerr container
WITH_SEERR=true

# host = rclone on the host via systemd (recommended)
# docker = rclone in a privileged container (fallback if host FUSE works poorly)
RCLONE_MODE=host
